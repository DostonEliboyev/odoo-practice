<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_service_payment_list" model="ir.ui.view">
    <field name="name">service.payment.list</field>
    <field name="model">service.payment</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="payment_date"/>
        <field name="amount"/>
        <field name="state"/>
        <field name="method"/>
        <field name="center_id"/>
        <field name="order_id"/>
        <field name="customer_id"/>
      </list>
    </field>
  </record>

  <record id="view_service_payment_form" model="ir.ui.view">
    <field name="name">service.payment.form</field>
    <field name="model">service.payment</field>
    <field name="arch" type="xml">
      <form string="Payment">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="payment_date"/>
              <field name="amount"/>
              <field name="method"/>
              <field name="state"/>
            </group>
            <group>
              <field name="center_id"/>
              <field name="order_id"/>
              <field name="customer_id"/>
            </group>
          </group>
          <group string="Order/Customer Totals">
            <field name="order_total" readonly="1"/>
            <field name="order_balance_due" readonly="1"/>
            <field name="customer_total_payment" readonly="1"/>
          </group>
          <group>
            <field name="note"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
