<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_service_part_list" model="ir.ui.view">
    <field name="name">service.part.list</field>
    <field name="model">service.part</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="is_active"/>
      </list>
    </field>
  </record>

  <record id="view_service_part_form" model="ir.ui.view">
    <field name="name">service.part.form</field>
    <field name="model">service.part</field>
    <field name="arch" type="xml">
      <form string="Part">
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="is_active"/>
          </group>
          <group>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
