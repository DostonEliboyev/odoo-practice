<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_service_center_list" model="ir.ui.view">
    <field name="name">service.center.list</field>
    <field name="model">service.center</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="is_active"/>
<!--        <field name="country_id"/>-->
<!--        <field name="state_id"/>-->
<!--        <field name="district_id"/>-->
<!--        <field name="phone"/>-->
<!--        <field name="email"/>-->
<!--        <field name="capacity_per_day"/>-->
        <field name="active_order_count"/>
<!--        <field name="done_order_count"/>-->
<!--        <field name="avg_rating"/>-->
<!--        <field name="total_revenue"/>-->
      </list>
    </field>
  </record>

  <record id="view_service_center_form" model="ir.ui.view">
    <field name="name">service.center.form</field>
    <field name="model">service.center</field>
    <field name="arch" type="xml">
      <form string="Service Center">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="is_active"/>
              <field name="manager_name"/>
              <field name="capacity_per_day"/>
              <field name="utilization_rate" readonly="1"/>
            </group>

          </group>

          <notebook>
            <page string="Orders">
<!--              <field name="order_ids" widget="many2many_tags"/>-->
              <group>
<!--                <field name="active_order_ids" widget="many2many_tags"/>-->
                <field name="active_order_count" readonly="1"/>
<!--                <field name="done_order_ids" widget="many2many_tags"/>-->
                <field name="done_order_count" readonly="1"/>
<!--                <field name="today_order_ids" widget="many2many_tags"/>-->
              </group>
            </page>
            <page string="Payments">
<!--              <field name="payment_ids" widget="many2many_tags"/>-->
              <group>
                <field name="total_revenue" readonly="1"/>
                <field name="last_order_date" readonly="1"/>
              </group>
            </page>
            <page string="Ratings">
<!--              <field name="rating_ids" widget="many2many_tags"/>-->
              <group>
                <field name="avg_rating" readonly="1"/>
              </group>
            </page>
            <page string="Technicians">
              <field name="technician_ids"/>
            </page>
            <page string="Notes">
              <field name="description"/>
            </page>
            <page string="Infomation">
                <group>
<!--                  <field name="country_id"/>-->
<!--                  <field name="state_id"/>-->
<!--                  <field name="district_id"/>-->
<!--                  <field name="address"/>-->
<!--                  <field name="phone"/>-->
<!--                  <field name="email"/>-->
<!--                  <field name="latitude"/>-->
<!--                  <field name="longitude"/>-->
                </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
