<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_service_order_line_list" model="ir.ui.view">
    <field name="name">service.order.line.list</field>
    <field name="model">service.order.line</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="name"/>
        <field name="order_id"/>
        <field name="part_id"/>
        <field name="description"/>
        <field name="note"/>
      </list>
    </field>
  </record>

  <record id="view_service_order_line_form" model="ir.ui.view">
    <field name="name">service.order.line.form</field>
    <field name="model">service.order.line</field>
    <field name="arch" type="xml">
      <form string="Order Line">
        <sheet>
          <group>
            <field name="name"/>
            <field name="order_id"/>
            <field name="part_id"/>
            <field name="description"/>
            <field name="note"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
