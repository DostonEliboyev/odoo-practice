<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- list (List) view -->
    <record id="view_writelogs_logs_list" model="ir.ui.view">
        <field name="name">writelogs.logs.list</field>
        <field name="model">writelogs.logs</field>
        <field name="arch" type="xml">
            <list>
                <field name="username"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_writelogs_logs_form" model="ir.ui.view">
        <field name="name">writelogs.logs.form</field>
        <field name="model">writelogs.logs</field>
        <field name="arch" type="xml">
            <form string="Log">
                <sheet>
                    <group>
                        <field name="username"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_writelogs_logs" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">writelogs.logs</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>View and maintain logs.</p>
        </field>
    </record>

    <!-- Submenu: Logs -->
    <menuitem id="menu_writelogs_logs"
              name="Logs"
              parent="menu_writelogs_root"
              action="action_writelogs_logs"
              sequence="20"/>

</odoo>
