<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- list (List) view -->
    <record id="view_writelogs_product_list" model="ir.ui.view">
        <field name="name">writelogs.product.list</field>
        <field name="model">writelogs.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_writelogs_product_form" model="ir.ui.view">
        <field name="name">writelogs.product.form</field>
        <field name="model">writelogs.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="price"/>
                        <field name="quantity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_writelogs_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">writelogs.product</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create and manage simple products.</p>
        </field>
    </record>

    <!-- Root menu -->
    <menuitem id="menu_writelogs_root" name="WriteLogs" sequence="10"/>

    <!-- Submenu: Products -->
    <menuitem id="menu_writelogs_products"
              name="Products"
              parent="menu_writelogs_root"
              action="action_writelogs_product"
              sequence="10"/>

</odoo>
